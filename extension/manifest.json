{
  "manifest_version": 3,
  "name": "Video Downloader Button",
  "version": "1.4",
  "description": "Adds a Download button on YouTube video pages you already have open. Sends the video to the Video Downloader app.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}